# Copy to `.env` and fill in. NEVER commit `.env` (it is gitignored).

# Google Gemini (free tier for MVP). Get a key from Google AI Studio.
GEMINI_API_KEY=your-gemini-api-key-here

# Gemini model id. Confirm the exact current free-tier string + limits in AI Studio.
GEMINI_MODEL=gemini-3-flash

# Local SQLite database path (the `data/` dir is gitignored).
DISTIL_DB_PATH=./data/distil.db
