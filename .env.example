# Copy to `.env` and fill in. NEVER commit `.env` (it is gitignored).

# Which LLM backend fills the extractor/explainer ports: 'gemini' or 'deepseek'. Both satisfy the
# same port; only the client below changes (decision-shift DS-0002). Default is 'gemini'.
LLM_PROVIDER=gemini

# --- Google Gemini (free tier for MVP). Get a key from Google AI Studio. ---
GEMINI_API_KEY=your-gemini-api-key-here

# Gemini model id. The planned 'gemini-3-flash' is not a real API id; the Gemini 3 Flash model is
# served as 'gemini-3-flash-preview'. Confirm the free-tier limits for it in AI Studio.
GEMINI_MODEL=gemini-3-flash-preview

# --- DeepSeek (OpenAI-compatible API). Used only when LLM_PROVIDER=deepseek. ---
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Local SQLite database path (the `data/` dir is gitignored).
DISTIL_DB_PATH=./data/distil.db
